# ==============================================================================
# Kalano Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the backend/ directory:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Supabase Project Configuration
# The REST API endpoint URL for your Supabase project
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon / Public API Key (backend uses this to authenticate requests)
SUPABASE_KEY=your-anon-key-here

# JWT Authentication Configuration
# Secret key used to sign and verify JSON Web Tokens (min 32 characters)
JWT_SECRET_KEY=your-secret-key-at-least-32-chars-change-in-production

# Algorithm used for JWT encoding and decoding (default: HS256)
JWT_ALGORITHM=HS256

# Access token validity lifetime in minutes (default: 60 minutes)
JWT_EXPIRATION_MINUTES=60

# Frontend URL / Allowed CORS Origin
# URL of the Next.js frontend application allowed to make cross-origin requests
FRONTEND_URL=http://localhost:3000