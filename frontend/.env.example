# ==============================================================================
# Kalano Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local in the frontend/ directory:
#   cp .env.example .env.local
#
# DO NOT commit real secrets to source control.
# Note: In compliance with the Kalano Constitution, the frontend is a thin client
# and never directly connects to Supabase. All data access flows through FastAPI.
# ==============================================================================

# Backend REST API Service Base URL
# Points to the running FastAPI backend instance (default development port: 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
